{
  "name": "sorttrip-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test:gate-d": "node --test checks/gate-d-isolation.test.mjs checks/gate-d-safety.test.mjs checks/meta-qa.test.mjs checks/video-itinerary.test.mjs checks/phase2b.test.mjs checks/assistant-discovery.test.mjs checks/phase2c.test.mjs checks/staging.test.mjs checks/assistant-combined.test.mjs",
    "build:staging": "tsc --noEmit && vite build --config vite.staging.config.js --mode staging && node scripts/staging-verify.mjs",
    "test:staging": "node --test checks/staging.test.mjs",
    "verify:staging": "node scripts/staging-verify.mjs",
    "build:staging-worker": "node scripts/staging-worker-build.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "dev:worker": "wrangler dev --ip 127.0.0.1 --port 8787",
    "dev:worker:browser": "wrangler dev --config wrangler.hotel-browser.jsonc --ip 127.0.0.1 --port 8787",
    "test:api": "node --test checks/flights-api.test.mjs checks/flight-itinerary.test.mjs checks/ai-itinerary.test.mjs checks/viator-api.test.mjs",
    "deploy:check": "wrangler deploy --dry-run",
    "telegram:check": "node --env-file=.env.telegram.local scripts/telegram-notify.mjs --check",
    "telegram:notify": "node --env-file=.env.telegram.local scripts/telegram-notify.mjs",
    "test:telegram": "node --test checks/telegram-notify.test.mjs checks/telegram-agent.test.mjs",
    "telegram:agent": "node --env-file=.env.telegram.local scripts/telegram-agent.mjs",
    "support:webhook": "node --env-file=.env.support.local scripts/support-webhook.mjs",
    "dev:mvp-demo": "vite --config vite.mvp-demo.config.js --mode mvp-demo",
    "build:mvp-demo": "tsc --noEmit && vite build --config vite.mvp-demo.config.js --mode mvp-demo",
    "test:mvp": "node --test checks/mvp-video.test.mjs checks/mvp-persistence.test.mjs checks/tour-guide.test.mjs",
    "dev:qa-preparation": "vite --config vite.qa-preparation.config.js --mode qa-preparation",
    "dev:gate-d-demo": "vite --config vite.gate-d-demo.config.js --mode qa-preparation",
    "build:gate-d-demo": "tsc --noEmit && vite build --config vite.gate-d-demo.config.js --mode qa-preparation",
    "dev:qa-gate-b": "vite --config vite.qa-gate-b.config.js --mode qa-preparation",
    "qa:config:check": "node scripts/qa-config-status.mjs",
    "build:qa-preparation": "tsc --noEmit && vite build --config vite.qa-preparation.config.js --mode qa-preparation",
    "dev:owner-ui": "vite --config vite.owner-ui.config.js --mode owner-ui",
    "build:owner-ui": "tsc --noEmit && vite build --config vite.owner-ui.config.js --mode owner-ui",
    "dev:gate-d-live": "vite --config vite.gate-d-live.config.js --mode qa-preparation",
    "test:meta-cutoff": "node --test checks/meta-cutoff.test.mjs checks/gate-d-live.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@supabase/supabase-js": "^2.117.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "i18next": "^26.4.3",
    "leaflet": "1.9.4",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "^17.0.16",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.151.3"
  }
}
